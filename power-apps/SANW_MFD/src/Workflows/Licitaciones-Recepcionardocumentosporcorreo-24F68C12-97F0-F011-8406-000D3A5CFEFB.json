                          "emailMessage/MailboxAddress": "SANW-MFD-Licitaciones@mail.ChurchofJesusChrist.org",
                          "emailMessage/To": "@triggerOutputs()?['body/from']",
                          "emailMessage/Subject": "Propuesta no recepcionada – Proceso de Licitación",
                          "emailMessage/Body": "<p>\nEstimado proveedor \n<strong>@{outputs('Get_a_row_by_ID_from_selected_environment_-_Vendor')?['body/mfd_name']}</strong>,<br><br>\n\nHemos recibido un intento de envío de <strong>documentos de respaldo</strong> correspondiente a la licitación  \n<strong>@{outputs('Get_a_row_by_ID_from_selected_environment_-_Bid')?['body/mfd_bidid']}</strong>.<br><br>\n\nSin embargo, el proceso de <strong>Recepción de sobres aún no ha iniciado</strong>.<br><br>\n\nPor este motivo, los archivos enviados <strong>no han sido recepcionados ni almacenados</strong> en el sistema.\nLe solicitamos esperar la indicación oficial del moderador de la licitación, momento en el cual se habilitará el plazo para el envío de documentos de respaldo de su propuesta económica.<br><br>\n\nUna vez iniciada la etapa de <strong>Recepción de sobres</strong>, deberá realizar nuevamente el envío dentro del tiempo establecido.<br><br>\n\nAgradecemos su comprensión.<br><br>\n\nAtentamente,<br><br>\n<strong>Departamento de Propiedades</strong><br>\nÁrea Sudamérica Noroeste\n</p>",
                          "emailMessage/Importance": "Normal"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
