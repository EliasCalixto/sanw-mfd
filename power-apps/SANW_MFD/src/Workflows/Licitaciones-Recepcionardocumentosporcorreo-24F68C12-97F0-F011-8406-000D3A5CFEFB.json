                                },
                                "parameters": {
                                  "emailMessage/MailboxAddress": "SANW-MFD-Licitaciones@mail.ChurchofJesusChrist.org",
                                  "emailMessage/To": "@triggerOutputs()?['body/from']",
                                  "emailMessage/Subject": "Documentos de respaldo recepcionados – Proceso de Licitación",
                                  "emailMessage/Body": "<p>\nEstimado proveedor <strong>@{outputs('Get_a_row_by_ID_from_selected_environment_-_Vendor')?['body/mfd_name']}</strong>,\n</p>\n\n<p>\nConfirmamos la <strong>recepción correcta de los documentos de respaldo</strong> correspondientes a su propuesta económica para la licitación\n<strong>@{outputs('Get_a_row_by_ID_from_selected_environment_-_Bid')?['body/mfd_bidid']}</strong>.\n</p>\n\n<p>\nLos archivos enviados han sido registrados y almacenados satisfactoriamente en el sistema, y serán considerados como parte del proceso de evaluación conforme a las condiciones y etapas establecidas para esta licitación.\n</p>\n\n<p>\n<strong>No es necesario realizar ningún envío adicional</strong>, salvo que sea expresamente solicitado por el equipo a cargo del proceso.\n</p>\n\n<p>\nAgradecemos su participación y el cumplimiento oportuno de los requerimientos del proceso de licitación.\n</p>\n\n<p>\nAtentamente,<br><br>\n<strong>Departamento de Propiedades</strong><br>\nÁrea Sudamérica Noroeste\n</p>",
                                  "emailMessage/Importance": "Normal"
                                },
                                "authentication": "@parameters('$authentication')"
                              }
                            }
