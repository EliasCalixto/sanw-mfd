          "metadata": {
            "operationMetadataId": "1be53c3a-585e-4822-9592-43d931f5e84f"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_approvals",
              "operationId": "StartAndWaitForAnApproval",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals"
            },
            "parameters": {
              "approvalType": "BasicAwaitAll",
              "WebhookApprovalCreationInput/title": "Aprobación de participación en la licitación @{triggerBody()['text_1']}",
              "WebhookApprovalCreationInput/assignedTo": "@{triggerBody()['text_6']};@{triggerBody()['text_7']};@{triggerBody()['text_8']};",
              "WebhookApprovalCreationInput/details": "Se requiere su conformidad (aprobación) de que ha participado en la apertura de sobres de la licitación @{triggerBody()['text_2']} - @{triggerBody()['text_1']}\nFecha de inicio de apertura de sobres: @{variables('StartDateText')}\nFecha de cierra de la licitación: @{variables('EndDateText')}\n\nProveedores postulados:\n@{variables('galProposals')}\n\n\nSaludos,\nSistema de Licitaciones – Departamento de Propiedades\nÁrea Sudamérica Noroeste",
              "WebhookApprovalCreationInput/enableNotifications": true,
              "WebhookApprovalCreationInput/enableReassignment": false
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Initialize_variable_-_galProposals": {
          "runAfter": {
            "Parse_JSON": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "814589b2-6fd0-4aef-9bc3-0300263884e3"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "galProposals",
                "type": "string"
              }
            ]
          }
        },
        "Apply_to_each_-_galProposals": {
          "foreach": "@body('Parse_JSON')",
          "actions": {
            "Append_to_string_variable_-_galProposals": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "dfd99a04-0803-4ba3-aad1-bc51bf403523"
              },
              "type": "AppendToStringVariable",
              "inputs": {
                "name": "galProposals",
                "value": "@concat(\n   '- ', items('Apply_to_each_-_galProposals')?['VendorName'],\n   ' - ', items('Apply_to_each_-_galProposals')?['VendorRepresentative'],\n   ' ', string(items('Apply_to_each_-_galProposals')?['ProposedDuration']),\n   ' ', string(items('Apply_to_each_-_galProposals')?['Amount']),\n   decodeUriComponent('%0A')\n)"
              }
            }
          },
          "runAfter": {
            "Initialize_variable_-_galProposals": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "28cae3f7-38eb-4670-835c-f59b14b6716c"
