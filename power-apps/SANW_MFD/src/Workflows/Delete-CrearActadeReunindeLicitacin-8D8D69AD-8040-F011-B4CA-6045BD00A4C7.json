              "type": "AppendToStringVariable",
              "inputs": {
                "name": "galProposals",
                "value": "@concat(items('Apply_to_each_-_galProposals')?['CurrencyCode'], ' ', string(items('Apply_to_each_-_galProposals')?['Amount']), ' - ', items('Apply_to_each_-_galProposals')?['VendorName'], '\\n')"
              }
            }
          },
          "runAfter": {
            "Initialize_variable_-_galProposals": [
              "Succeeded"
